# ---------------------------------------------------------------------------
# ERZEUGTE DATEI - nicht von Hand aendern.
#
# Variante: hw21x_cyclone_10 - GottFA1_PLuS HW v2.1x mit dem Cyclone-10-Board (10CL006YE144C8G)
# Erzeugt : scripts\gen_qsf.ps1
# Quellen : scripts\common_header.tcl, device.tcl, pins.tcl,
#           scripts\files_common.tcl + files_<family>.tcl + files_<option>.tcl
#
# device.tcl / pins.tcl / variant.psd1 oder die Dateilisten aendern, dann
# gen_qsf.ps1 erneut laufen lassen. Aenderungen direkt in dieser Datei sind
# beim naechsten Lauf weg - und Quartus schreibt selbst hinein, sobald das
# Projekt in der IDE offen ist. Deshalb erzeugen check.ps1 und build.ps1 die
# Datei neu, bevor sie bauen.
# ---------------------------------------------------------------------------

# --- Board -----------------------------------------------------------------
set_global_assignment -name TOP_LEVEL_ENTITY SYS1
set_global_assignment -name FAMILY "Cyclone 10 LP"
set_global_assignment -name DEVICE 10CL006YE144C8G
set_global_assignment -name LAST_QUARTUS_VERSION "22.1std.2 Lite Edition"

# --- gemeinsame globale Assignments -----------------------------------------
set_global_assignment -name ORIGINAL_QUARTUS_VERSION "13.0 SP1"
set_global_assignment -name PROJECT_CREATION_TIME_DATE "15:47:39  AUGUST 26, 2020"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name ERROR_CHECK_FREQUENCY_DIVISOR 1
set_global_assignment -name NUM_PARALLEL_PROCESSORS 14
set_global_assignment -name USE_CONFIGURATION_DEVICE ON
set_global_assignment -name RESERVE_ALL_UNUSED_PINS "AS INPUT TRI-STATED WITH WEAK PULL-UP"
set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top
set_global_assignment -name STRATIX_DEVICE_IO_STANDARD "3.3-V LVTTL"
set_global_assignment -name CYCLONEII_RESERVE_NCEO_AFTER_CONFIGURATION "USE AS REGULAR IO"
set_global_assignment -name RESERVE_ASDO_AFTER_CONFIGURATION "USE AS REGULAR IO"
set_global_assignment -name POWER_PRESET_COOLING_SOLUTION "23 MM HEAT SINK WITH 200 LFPM AIRFLOW"
set_global_assignment -name POWER_BOARD_THERMAL_MODEL "NONE (CONSERVATIVE)"
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to sw_reset
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to reset_sw
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to Button_Test
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to SB_Dip_Return
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to SB_Test
set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top

# --- optionale Top-Level-Ports, die dieses Board nicht hat -------------------
# Sie bleiben in der Portliste, damit alle Varianten EIN Top-Level teilen.
# VIRTUAL_PIN haelt Quartus davon ab, sie auf einen echten Pin zu legen und
# zu treiben.
set_instance_assignment -name VIRTUAL_PIN ON -to LED_Test
set_instance_assignment -name VIRTUAL_PIN ON -to USB_Rx
set_instance_assignment -name VIRTUAL_PIN ON -to USB_Tx

# --- Pins -------------------------------------------------------------------
